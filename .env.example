NODE_ENV=development
PORT=5000

# PostgreSQL — Prisma reads this single connection string.
# Local dev example: postgresql://postgres:postgres@localhost:5432/hostel_finder_db?schema=public
# Production (Render): use the Internal Database URL from your Render Postgres instance.
DATABASE_URL=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Resend (email — OTP for registration and password reset)
RESEND_API_KEY=

# Frontend URL the "Create Password" screen lives at.
# Not currently used for the OTP flow's links, but kept for reference/future use.
RESET_PASSWORD_URL=http://localhost:3000/reset-password

# Cloudinary (photo uploads — listings + profile pictures)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=